# Copie para .env. Os valores abaixo servem só para desenvolvimento local;
# na nuvem, gere chaves novas (openssl rand -hex 32) e use os segredos da plataforma.

# Senha do SQL Server local (e do emulador do Service Bus, que usa o mesmo SQL Server).
MSSQL_SA_PASSWORD=PayFlow_Local_2026!

# Chave compartilhada com o BFF (32 a 256 caracteres). Igual à do merchant-service.
PAYFLOW_INTERNAL_KEY=local-dev-internal-key-0123456789abcdef

# Nuvem: descomente para usar o Azure SQL e o Service Bus em vez dos containers locais.
# AZURE_SQL_URL=jdbc:sqlserver://sql-payflow.database.windows.net:1433;database=payments;encrypt=true
# AZURE_SQL_USERNAME=
# AZURE_SQL_PASSWORD=
# SERVICEBUS_CONNECTION_STRING=Endpoint=sb://sb-payflow.servicebus.windows.net/;SharedAccessKeyName=send;SharedAccessKey=

SERVICEBUS_QUEUE=payment-events
API_PORT=8082
PAYMENT_SERVICE_IMAGE=payflow/payment-service:dev
